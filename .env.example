# MSP Warehouse — Template Konfigurasi Environment Produksi
# Salin file ini menjadi `.env` pada server target (`.env` otomatis diabaikan git & diblokir .htaccess).

APP_URL=https://wms.mspgrup.co.id
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_msp_warehouse
DB_USER=msp_user
DB_PASS=GANTI_DENGAN_PASSWORD_KUAT
DB_CHARSET=utf8mb4

# Email Driver: "mail" (PHP mail()) atau "smtp" (built-in pure-PHP SMTP socket)
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@mspgrup.co.id
MAIL_FROM_NAME="MSP Warehouse"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=no-reply@mspgrup.co.id
SMTP_PASS=GANTI_DENGAN_PASSWORD_SMTP
SMTP_TIMEOUT=10

# Optional secret token untuk endpoint monitoring /health.php (via X-Health-Token / Bearer)
HEALTH_CHECK_TOKEN=GANTI_DENGAN_TOKEN_ACAK_MIN_32_KARAKTER
